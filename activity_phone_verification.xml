<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EEF2F7">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <!-- HEADER -->
        <LinearLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_hospicare_gradient"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to"
                android:textColor="#E0E7FF"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospicare"
                android:textColor="@android:color/white"
                android:textSize="34sp"
                android:textStyle="bold"/>
        </LinearLayout>


        <!-- LOGO -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logo_card"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="200dp"
            android:backgroundTint="@android:color/white"
            app:cardCornerRadius="65dp"
            app:cardElevation="10dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="22dp"
                android:src="@mipmap/logo2"
                android:scaleType="centerInside"/>
        </androidx.cardview.widget.CardView>


        <!-- INPUT CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/input_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/logo_card"
            android:layout_margin="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <!-- PHONE -->
                <EditText
                    android:id="@+id/edit_text_verify_phone_number"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_input_modern"
                    android:hint="+961 Phone Number"
                    android:textSize="16sp"
                    android:padding="14dp"
                    android:textColor="#0F172A"
                    android:inputType="phone"
                    android:focusable="true"
                    android:clickable="true"/>


                <!-- OTP -->
                <EditText
                    android:id="@+id/edit_text_verify_otp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_input_modern"
                    android:hint="Enter OTP"
                    android:textSize="16sp"
                    android:padding="14dp"
                    android:textColor="#0F172A"
                    android:inputType="number"/>


                <!-- GENERATE -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_generate_otp"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp"
                    android:text="Generate OTP"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"
                    android:backgroundTint="#2563EB"
                    app:cornerRadius="14dp"/>


                <!-- VERIFY -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_verify_number"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:text="Verify &amp; Continue"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"
                    android:backgroundTint="#10B981"
                    app:cornerRadius="14dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </RelativeLayout>
</ScrollView>
