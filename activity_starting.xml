<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F1F5F9"
    tools:context=".StartingActivity">

    <!-- TITLE -->
    <TextView
        android:id="@+id/start1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/welcome_title"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:textSize="26sp"
        android:layout_marginTop="24dp"/>

    <!-- LOGO -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/start_image"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_below="@id/start1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:src="@mipmap/logo2"/>

    <!-- SELECT ROLE TITLE -->
    <TextView
        android:id="@+id/start2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_role"
        android:gravity="center"
        android:textColor="#1E293B"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_below="@id/start_image"
        android:layout_marginTop="32dp"/>

    <!-- SUBTITLE -->
    <TextView
        android:id="@+id/start3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_continue"
        android:gravity="center"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:layout_below="@id/start2"
        android:layout_marginTop="6dp"/>

    <!-- DOCTOR BUTTON -->
    <Button
        android:id="@+id/button_start_doctor"
        android:layout_width="260dp"
        android:layout_height="52dp"
        android:text="@string/continue_doctor"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/custom_button_border_3"
        android:layout_below="@id/start3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="28dp"/>

    <!-- PATIENT BUTTON -->
    <Button
        android:id="@+id/button_start_patient"
        android:layout_width="260dp"
        android:layout_height="52dp"
        android:text="@string/continue_patient"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/custom_button_border_2"
        android:layout_below="@id/button_start_doctor"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"/>

</RelativeLayout>