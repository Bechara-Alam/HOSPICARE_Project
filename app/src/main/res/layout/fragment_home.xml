<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HERO IMAGE -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@mipmap/hosp"
                android:scaleType="centerCrop"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_header_overlay"/>

            <TextView
                android:id="@+id/textUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello, User 👋"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="20dp"
                android:layout_gravity="bottom|start"/>
        </FrameLayout>

        <!-- CONTENT -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- EMERGENCY -->
            <LinearLayout
                android:id="@+id/button_emergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_emergency"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_emergency"
                    app:tint="@android:color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Emergency • Call Ambulance"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- GRID -->
            <GridLayout
                android:columnCount="2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- CARD 1 -->
                <LinearLayout
                    android:id="@+id/button_book_appointment"
                    android:background="@drawable/bg_card"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <ImageView
                        android:src="@drawable/ic_appointment"
                        android:layout_width="32dp"
                        android:layout_height="32dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book Appointment"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>

                <!-- CARD 2 -->
                <LinearLayout
                    android:id="@+id/button_find_doctors"
                    android:background="@drawable/bg_card"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <ImageView
                        android:src="@drawable/ic_doctor"
                        android:layout_width="32dp"
                        android:layout_height="32dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Find Doctors"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>

                <!-- CARD 3 -->
                <LinearLayout
                    android:id="@+id/button_view_prescriptions"
                    android:background="@drawable/bg_card"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <ImageView
                        android:src="@drawable/ic_prescription"
                        android:layout_width="32dp"
                        android:layout_height="32dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Prescriptions"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>

                <!-- CARD 4 -->
                <LinearLayout
                    android:id="@+id/button_medical_records"
                    android:background="@drawable/bg_card"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_margin="6dp"
                    android:padding="16dp"
                    android:orientation="vertical">

                    <ImageView
                        android:src="@drawable/ic_records"
                        android:layout_width="32dp"
                        android:layout_height="32dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lab Results"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"/>
                </LinearLayout>

            </GridLayout>

            <!-- NOTIFICATIONS -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/button_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card"
                    android:foreground="@drawable/ripple_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:src="@drawable/ic_notification"
                        android:layout_width="24dp"
                        android:layout_height="24dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recent Activity &amp; Notifications"
                        android:layout_marginStart="12dp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <View
                    android:id="@+id/notification_badge"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="end|top"
                    android:layout_margin="10dp"
                    android:background="@drawable/badge_red"/>
            </FrameLayout>

            <!-- LAB -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Laboratory Services"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <LinearLayout
                android:id="@+id/button_book_lab"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_blue_gradient"
                android:foreground="@drawable/ripple_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginTop="10dp">

                <ImageView
                    android:src="@drawable/ic_lab"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    app:tint="@android:color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book Lab Test"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>