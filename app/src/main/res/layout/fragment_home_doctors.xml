<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#F4FAFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER -->
        <TextView
            android:id="@+id/homet1"
            android:text="Good Morning,"
            android:textSize="16sp"
            android:textColor="#6B7C8C" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

        <TextView
            android:id="@+id/text_view_home_name"
            android:text="Dr. Name"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A2B3C"
            android:layout_marginBottom="20dp" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

        <!-- APPOINTMENTS -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Appointments"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#1A2B3C" android:layout_height="wrap_content" android:layout_width="wrap_content"/>

            <TextView
                android:layout_width="match_parent"
                android:gravity="end"
                android:text="TODAY"
                android:textColor="#3F8CFF"
                android:textSize="12sp" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- CARD GROUP -->
        <LinearLayout
            android:background="#EAF3FB"
            android:padding="16dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- APPROVE -->
            <LinearLayout
                android:id="@+id/button_approve_appointments"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_white"
                android:layout_marginBottom="10dp"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_blue"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_agenda"/>

                <LinearLayout
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_height="wrap_content" android:layout_width="wrap_content"
                        android:text="Approve Scheduled"
                        android:textStyle="bold"
                        android:textSize="14sp"/>


                </LinearLayout>

                <TextView android:text=">" android:textColor="#AAA" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
            </LinearLayout>

            <!-- PENDING -->
            <LinearLayout
                android:id="@+id/button_pending_appointments"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_white"
                android:layout_marginBottom="10dp"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_teal"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_popup_sync"/>

                <LinearLayout
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_height="wrap_content" android:layout_width="wrap_content"
                        android:text="Pending Review"
                        android:textStyle="bold"
                        android:textSize="14sp"/>


                </LinearLayout>

                <TextView android:text=">" android:textColor="#AAA" android:layout_height="wrap_content" android:layout_width="wrap_content"/>
            </LinearLayout>

            <!-- COMPLETED -->
            <LinearLayout
                android:id="@+id/button_completed_appointments"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_white"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_light"
                    android:padding="8dp"
                    android:src="@android:drawable/checkbox_on_background"/>

                <LinearLayout
                    android:layout_marginStart="12dp"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_height="wrap_content" android:layout_width="wrap_content"
                        android:text="Completed Sessions"
                        android:textStyle="bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_height="wrap_content" android:layout_width="wrap_content"
                        android:text="View daily history"
                        android:textSize="12sp"
                        android:textColor="#6B7C8C"/>
                </LinearLayout>

                <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:text=">" android:textColor="#AAA"/>
            </LinearLayout>

        </LinearLayout>

        <!-- PATIENTS -->
        <TextView
            android:layout_height="wrap_content" android:layout_width="wrap_content"
            android:text="Patient Management"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="20dp"/>

        <LinearLayout
            android:id="@+id/button_your_patients"
            android:background="#ECF5FB"
            android:padding="16dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_height="wrap_content" android:layout_width="wrap_content"
                android:text="Your Patients"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:layout_height="wrap_content" android:layout_width="wrap_content"
                android:text="Active roster: 142"
                android:textColor="#6B7C8C"/>

        </LinearLayout>

        <!-- LAB -->
    </LinearLayout>
</ScrollView>