<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Left icon background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_container"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_alignParentStart="true"
            android:backgroundTint="#EAF2FF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <!-- REAL doctor avatar image -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/doctor_avatar"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Doctor Name -->
        <TextView
            android:id="@+id/text_doctor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/icon_container"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:text="Dr Adiveppa Hosangadi"
            android:textColor="#111827"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <!-- Doctor Specialty -->
        <TextView
            android:id="@+id/text_doctor_field"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/text_doctor_name"
            android:layout_toEndOf="@id/icon_container"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:text="Orthopedics"
            android:textColor="#6B7280"
            android:textSize="14sp"/>

        <!-- Right arrow -->
        <ImageView
            android:id="@+id/img_arrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_right"
            android:tint="#9CA3AF"/>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
