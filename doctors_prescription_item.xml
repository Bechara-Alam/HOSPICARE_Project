<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:backgroundTint="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_view_doctor_prescription_patient_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="John Doe"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/text_view_doctor_prescription_medicine_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paracetamol"
            android:textSize="16sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="12dp"/>

        <!-- Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/button_breakfast_doctor_prescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breakfast"
                android:visibility="gone"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/button_lunch_doctor_prescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lunch"
                android:visibility="gone"
                android:layout_marginStart="6dp"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/button_dinner_doctor_prescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dinner"
                android:visibility="gone"
                android:layout_marginStart="6dp"
                android:textSize="12sp"/>

        </LinearLayout>

        <TextView
            android:id="@+id/text_view_date_start_doctor_prescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start: 01 Mar 2026"
            android:textColor="#374151"/>

        <TextView
            android:id="@+id/text_view_date_end_doctor_prescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End: 05 Mar 2026"
            android:textColor="#374151"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/text_view_item_medicine_duration_doctor_prescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duration: 5 Days"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>