<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#EDEFF2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Laboratory Test"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2C3E50"
            android:layout_marginBottom="20dp"/>

        <Spinner
            android:id="@+id/spinner_tests"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edit_date"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Preferred Date"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/edit_notes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Additional Notes (Optional)"
            android:gravity="top"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/button_submit_lab"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Submit Request"
            android:background="@drawable/button_blue_rounded"
            android:textColor="@android:color/white"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>