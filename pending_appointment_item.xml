<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:strokeColor="#C9D7EA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#EAF2FB">

        <TextView
            android:id="@+id/text_view_item_pending_appointment_patient_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ali"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"/>

        <TextView
            android:id="@+id/text_view_item_pending_appointment_patient_contact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="3333333333"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/text_view_item_pending_appointment_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="12/03/2026"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/text_view_item_pending_appointment_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="02:00 PM"
            android:textSize="16sp"
            android:textStyle="bold"/>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_view_call_patient"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_telephone_call"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:id="@+id/image_view_message_patient"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_telephone_message"/>
        </LinearLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_mark_completed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Mark as Completed"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:backgroundTint="#1B48DB"
            app:cornerRadius="12dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
