<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    android:backgroundTint="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Medicine name -->
        <TextView
            android:id="@+id/text_view_medicine_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paracetamol"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:layout_marginBottom="4dp"/>

        <!-- Doctor -->
        <TextView
            android:id="@+id/text_view_doctor_prescribed_by"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prescribed by Dr. Ahmad"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="16dp"/>

        <!-- Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#374151"
                android:layout_marginEnd="10dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/button_breakfast"
                android:text="Breakfast"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#3B82F6"
                android:visibility="gone"
                android:layout_marginEnd="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/button_lunch"
                android:text="Lunch"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#3B82F6"
                android:visibility="gone"
                android:layout_marginEnd="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <com.google.android.material.chip.Chip
                android:id="@+id/button_dinner"
                android:text="Dinner"
                android:textColor="@android:color/white"
                app:chipBackgroundColor="#3B82F6"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

        <!-- Date row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start:"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/text_view_date_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01 Mar 2026"
                android:textColor="#374151"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End:"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/text_view_date_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05 Mar 2026"
                android:textColor="#374151"/>

        </LinearLayout>

        <!-- Duration -->
        <TextView
            android:id="@+id/text_view_item_medicine_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Duration: 5 Days"
            android:textColor="#6B7280"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>